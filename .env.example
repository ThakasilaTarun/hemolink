# Copy this file to .env and fill in values from:
# Supabase Dashboard → Project Settings → API
#
# Project URL  → VITE_SUPABASE_URL
# anon public  → VITE_SUPABASE_PUBLISHABLE_KEY
# Project ref  → VITE_SUPABASE_PROJECT_ID (Settings → General)

VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-starts-with-eyJ
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# SendGrid (for send-email function / terminal test)
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=verified-sender@yourdomain.com
